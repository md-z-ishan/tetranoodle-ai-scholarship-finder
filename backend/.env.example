# Core Configuration & Environment Variables

# LLM Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_RPM=4

# Web Search Provider (Primary: Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# GitHub REST API (Optional: increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_optional

# Server & Application Settings
PORT=8000
HOST=0.0.0.0
DEBUG=False
LOG_LEVEL=INFO

# Swarm Execution Timeouts (seconds)
GLOBAL_RUN_TIMEOUT_SECONDS=180
PER_URL_FETCH_TIMEOUT_SECONDS=10
MAX_SEARCH_RESULTS=15
